# The executable is Burnos.exe. The project file, the source and the C++
# namespace are all still BurnOS - renaming those would gain nothing and the
# namespace appears on every second line.
TARGET = Burnos

QT       += core gui multimedia network

greaterThan(QT_MAJOR_VERSION, 4): QT += widgets

CONFIG += c++17

SOURCES += \
    composio.cpp \
    computeruse.cpp \
    installer.cpp \
    integrationsdialog.cpp \
    main.cpp \
    mainwindow.cpp \
    modelcatalogue.cpp \
    openrouter.cpp \
    orbwidget.cpp \
    settings.cpp \
    settingsdialog.cpp \
    sttengine.cpp \
    sttpaths.cpp \
    ttsengine.cpp

HEADERS += \
    composio.h \
    computeruse.h \
    installer.h \
    integrationsdialog.h \
    livelog.h \
    mainwindow.h \
    modelcatalogue.h \
    openrouter.h \
    orbwidget.h \
    settings.h \
    settingsdialog.h \
    sttengine.h \
    sttpaths.h \
    ttsengine.h

# DPAPI, used to encrypt the stored OpenRouter key for the current user.
# User32 for GetWindowRect, used by the window hit test that keeps everything
# except the orb itself click through.
# Ole32 and OleAut32 for UI Automation, which is COM; Shell32 for ShellExecute,
# which is how the computer use skill starts a program.
# Gdi32 for the screenshot: PrintWindow draws into a DIB section, which is GDI.
win32: LIBS += -lCrypt32 -lUser32 -lOle32 -lOleAut32 -lShell32 -lGdi32

# MinGW only: MSVC links uuid.lib by default, MinGW does not, and
# computeruse.cpp needs BHID_EnumItems from it.
win32-g++: LIBS += -luuid

# The executable wears the orb. burnos.ico is GENERATED by the program itself,
# from the same code that paints the orb on screen:
#
#     BurnOS.exe --export-icon Q:/C++/BurnOS/burnos.ico
#
# so it is only picked up once it exists. The very first build of a clean tree
# simply has no custom icon, and the second one does.
win32:exists($$PWD/burnos.ico): RC_ICONS = $$PWD/burnos.ico

# Default rules for deployment.
qnx: target.path = /tmp/$${TARGET}/bin
else: unix:!android: target.path = /opt/$${TARGET}/bin
!isEmpty(target.path): INSTALLS += target
